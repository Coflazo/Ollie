#!/usr/bin/env sh
# One command, for a working tree you are already in the middle of: no git pull, no test
# run, just build what changed and start. `START.command` is the same thing with those two
# steps included, and `scripts\ollie.cmd` is this file for Windows.
#
# `sh` rather than `bash`: nothing here needs bash, and the smaller container images do not
# ship it.
set -eu
cd "$(dirname "$0")/.."

for candidate in ./.venv/bin/python python3.13 python3.12 python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then
    exec "$candidate" scripts/launch.py --quick "$@"
  fi
done

echo "no Python found; install Python 3.12 or later" >&2
exit 1
